{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentfoundry/overlay.schema.json",
  "title": "Framework overlay",
  "allOf": [
    {"$ref": "portable-artifact-identity.schema.json"},
    {
      "properties": {
        "artifact_type": {"const": "overlay"},
        "operation": {"enum": ["add", "extend", "replace", "suppress"]},
        "target_artifact_type": {"type": "string", "minLength": 1},
        "target_artifact_id": {"type": "string", "minLength": 1},
        "added_artifact_type": {"type": "string", "minLength": 1},
        "added_artifact_id": {"type": "string", "minLength": 1},
        "replacement_artifact_type": {"type": "string", "minLength": 1},
        "replacement_artifact_id": {"type": "string", "minLength": 1},
        "priority": {"type": "integer"}
      },
      "required": ["operation"],
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "add"}}},
          "then": {"required": ["added_artifact_type", "added_artifact_id"]},
          "else": {"required": ["target_artifact_type"]}
        },
        {
          "if": {"properties": {"operation": {"enum": ["extend", "replace", "suppress"]}}},
          "then": {"required": ["target_artifact_id"]}
        },
        {
          "if": {"properties": {"operation": {"const": "replace"}}},
          "then": {"required": ["replacement_artifact_type", "replacement_artifact_id"]}
        }
      ]
    }
  ]
}
