{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentfoundry/execution-profile.schema.json",
  "title": "Agent Caravan Execution Profile",
  "type": "object",
  "required": ["artifact_type", "id", "version", "scope", "entry_roles", "activation_policy", "topology", "stages", "termination", "escalation"],
  "properties": {
    "artifact_type": {"const": "execution-profile"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "enum": ["shared", "organization", "team", "local", "session"]},
    "entry_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "activation_policy": {"type": "object"},
    "topology": {"$ref": "execution-contracts.schema.json#/$defs/executionTopology"},
    "stages": {"type": "array", "minItems": 1},
    "tool_requirements": {
      "type": "array",
      "items": {"$ref": "execution-contracts.schema.json#/$defs/toolRequirement"}
    },
    "evidence_requirements": {
      "type": "array",
      "items": {"$ref": "execution-contracts.schema.json#/$defs/evidenceRequirement"}
    },
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capability_support_requirements": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string", "enum": ["native", "adapted", "externalized", "unsupported"]}
    },
    "termination": {"$ref": "execution-contracts.schema.json#/$defs/termination"},
    "escalation": {"type": "object"},
    "policy_ids": {"type": "array", "items": {"type": "string"}},
    "reasoning_policy": {
      "type": "object",
      "properties": {
        "default": {"type": "string", "enum": ["focused", "standard", "deep"]},
        "role_defaults": {"type": "object", "additionalProperties": {"type": "string", "enum": ["focused", "standard", "deep"]}},
        "stage_overrides": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string", "enum": ["focused", "standard", "deep"]}}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
